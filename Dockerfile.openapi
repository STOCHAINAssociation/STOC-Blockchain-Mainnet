# docker build --platform linux/amd64 -f Dockerfile.openapi -t stoc-openapi . && docker run --rm --platform linux/amd64 -v $(pwd)/docs/static:/app/docs/static stoc-openapi

ARG TARGETPLATFORM=linux/amd64
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl git make gcc wget unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.24.3 (match go.mod toolchain)
# Derive architecture from TARGETPLATFORM for multi-arch builds
ENV GO_VERSION=1.24.3
ARG TARGETPLATFORM
RUN case "${TARGETPLATFORM}" in \
      "linux/arm64") ARCH="arm64" ;; \
      "linux/amd64"|*) ARCH="amd64" ;; \
    esac && \
    wget -q https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz \
    && tar -C /usr/local -xzf go${GO_VERSION}.linux-${ARCH}.tar.gz \
    && rm go${GO_VERSION}.linux-${ARCH}.tar.gz

ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

# Install Ignite CLI — pinned version with checksum verification for reproducible builds
ARG IGNITE_VERSION=28.8.0
RUN curl -fSL "https://github.com/ignite/cli/releases/download/v${IGNITE_VERSION}/ignite_${IGNITE_VERSION}_linux_amd64.tar.gz" \
      -o /tmp/ignite.tar.gz && \
    tar -xzf /tmp/ignite.tar.gz -C /usr/local/bin ignite && \
    chmod +x /usr/local/bin/ignite && \
    rm /tmp/ignite.tar.gz && \
    ignite version

# Install protoc-gen-openapiv2 (required for openapi generation)
# Pin to match go.mod grpc-gateway version for reproducible builds
RUN go install github.com/grpc-ecosystem/grpc-gateway/v2/protoc-gen-openapiv2@v2.27.3

# Set working directory and copy project first (ignite app install needs go.mod)
WORKDIR /app
COPY . .

# Download Go dependencies
RUN go mod download

# Create non-root user and set permissions for ignite generate output
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app && \
    mkdir -p /home/appuser/go && \
    cp -r /root/go/bin /home/appuser/go/ && \
    chown -R appuser:appuser /home/appuser/go

ENV GOPATH="/home/appuser/go"
ENV PATH="/usr/local/go/bin:/home/appuser/go/bin:${PATH}"

USER appuser

CMD ["ignite", "generate", "openapi", "--yes"]
