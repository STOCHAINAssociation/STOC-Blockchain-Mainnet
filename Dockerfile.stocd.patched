# Dockerfile.stocd.patched — Build stocd with EVM fixes for 6-decimal chains
#
# Patches cosmos/evm v0.6.0 upstream bugs that affect chains with non-18-decimal
# base denoms (e.g., STOC uses 6-decimal ustoc). Chains like Evmos (18-decimal
# aevmos) are unaffected.
#
# Fixed issues:
#   1. eth_gasPrice returns 10^12x too high — ConvertAmountTo18DecimalsLegacy
#      applied on values already in 18-decimal EVM scale
#   2. eth_getTransactionReceipt returns null for simple ETH-to-ETH transfers —
#      DecodeMsgLogs fails when no tx response data exists
#
# Usage:
#   docker build --platform linux/amd64 -f Dockerfile.stocd.patched -t stoc-build-patched .
#   docker run --rm -v /tmp:/output stoc-build-patched

FROM --platform=linux/amd64 golang:1.24.3 AS builder

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# =============================================================================
# Patch cosmos/evm v0.6.0
# =============================================================================
RUN MODCACHE=$(go env GOMODCACHE) && \
    EVM_MOD="$MODCACHE/github.com/cosmos/evm@v0.6.0" && \
    chmod -R u+w "$EVM_MOD" && \
    #
    # --- Fix 1: Gas price double-conversion (10^12x inflation) ---
    #
    # FeeMarketWrapper.GetParams() — MinGasPrice already in EVM 18-decimal scale
    sed -i 's|params.MinGasPrice = types.ConvertAmountTo18DecimalsLegacy(params.MinGasPrice)|// PATCHED: MinGasPrice already in EVM 18-decimal scale, skip conversion|' \
        "$EVM_MOD/x/vm/wrappers/feemarket.go" && \
    #
    # RPCMinGasPrice() — node config min gas price already in EVM scale
    sed -i 's|return evmtypes.ConvertAmountTo18DecimalsLegacy(amt).TruncateInt().BigInt()|return amt.TruncateInt().BigInt() // PATCHED: already in EVM scale|' \
        "$EVM_MOD/rpc/backend/node_info.go" && \
    #
    # --- Fix 2: Receipt null for simple ETH transfers ---
    #
    # DecodeMsgLogs() returns error when no tx response data (simple transfers).
    # Fix: return empty logs instead of error when msgIndex exceeds response count.
    sed -i 's|return nil, fmt.Errorf("invalid message index: %d", msgIndex)|return nil, nil // PATCHED: simple transfers have no tx responses, return empty logs|' \
        "$EVM_MOD/x/vm/types/utils.go" && \
    #
    echo "Patched cosmos/evm v0.6.0 (gas price + receipt)"

# Copy source and build
COPY . .
RUN go build -o /stocd ./cmd/stocd

# Output stage
FROM --platform=linux/amd64 ubuntu:22.04
COPY --from=builder /stocd /stocd
ENTRYPOINT ["sh", "-c", "cp /stocd /output/${BINARY_NAME:-stocd} && echo \"Built: /output/${BINARY_NAME:-stocd}\" && ls -lh /output/${BINARY_NAME:-stocd}"]
